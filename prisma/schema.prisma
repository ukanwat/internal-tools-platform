generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPPORT
  FINANCE_APPROVER
  COMPLIANCE_REVIEWER
  COMPLIANCE_LEAD
  ADMIN
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

enum ApprovalStatus {
  PENDING
  PROCESSING
  OUTCOME_UNKNOWN
  COMPLETED
  REJECTED
}

model User {
  id           String            @id
  email        String            @unique
  name         String
  role         Role
  createdAt    DateTime          @default(now()) @map("created_at")
  auditEntries AuditLog[]
  requested    ApprovalRequest[] @relation("requestedBy")
  decided      ApprovalRequest[] @relation("decidedBy")
  refunds      Refund[]
  attachments  Attachment[]

  @@map("users")
}

/// Append-only: a database trigger rejects UPDATE and DELETE.
model AuditLog {
  id         String       @id @default(cuid())
  createdAt  DateTime     @default(now()) @map("created_at")
  actorId    String?      @map("actor_id")
  actor      User?        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  /// Role at the time of the event; the user's role may change later.
  actorRole  Role?        @map("actor_role")
  action     String
  outcome    AuditOutcome
  entityType String?      @map("entity_type")
  entityId   String?      @map("entity_id")
  before     Json?
  after      Json?
  reason     String?

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([outcome, createdAt])
  @@index([entityType, entityId])
  @@map("audit_log")
}

model ApprovalRequest {
  id                  String         @id @default(cuid())
  /// Registered approval type key, e.g. `refunds.issue`.
  type                String
  status              ApprovalStatus @default(PENDING)
  payload             Json
  summary             String
  entityType          String?        @map("entity_type")
  entityId            String?        @map("entity_id")
  requestedById       String         @map("requested_by_id")
  requestedBy         User           @relation("requestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  requestReason       String         @map("request_reason")
  decidedById         String?        @map("decided_by_id")
  decidedBy           User?          @relation("decidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  decisionReason      String?        @map("decision_reason")
  decidedAt           DateTime?      @map("decided_at")
  processingStartedAt DateTime?      @map("processing_started_at")
  completedAt         DateTime?      @map("completed_at")
  lastError           String?        @map("last_error")
  attempts            Int            @default(0)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  @@index([status, type])
  @@index([requestedById, createdAt])
  @@index([status, processingStartedAt])
  @@map("approval_requests")
}

// Refunds tool

/// A customer order that support can refund. Fake data only.
model Order {
  id            String   @id @default(cuid())
  /// Customer-facing order number, e.g. `ORD-1001`.
  number        String   @unique
  customerName  String   @map("customer_name")
  customerEmail String   @map("customer_email")
  amountMinor   Int      @map("amount_minor")
  currency      String
  /// Payment in the payments provider that refunds are paid against.
  paymentId     String   @map("payment_id")
  /// Bank account refunds are paid to. Sensitive: masked unless revealed.
  accountNumber String   @map("account_number")
  placedAt      DateTime @map("placed_at")
  refunds       Refund[]

  @@index([customerEmail])
  @@map("orders")
}

enum RefundStatus {
  PROCESSING
  PAID
  FAILED
}

model Refund {
  id                String        @id @default(cuid())
  orderId           String        @map("order_id")
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  amountMinor       Int           @map("amount_minor")
  currency          String
  reason            String
  requestedById     String        @map("requested_by_id")
  requestedBy       User          @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  /// Set for refunds that need approval; their status comes from the approval request.
  approvalRequestId String?       @unique @map("approval_request_id")
  /// Set for refunds paid straight away (at or under the approval threshold).
  status            RefundStatus?
  paidAt            DateTime?     @map("paid_at")
  lastError         String?       @map("last_error")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("refunds")
}

/// Backing store for the mock payments integration.
model MockPayment {
  id             String            @id @default(cuid())
  idempotencyKey String            @unique @map("idempotency_key")
  kind           String
  paymentId      String            @map("payment_id")
  amountMinor    Int               @map("amount_minor")
  currency       String
  status         MockPaymentStatus @default(PENDING)
  createdAt      DateTime          @default(now()) @map("created_at")

  @@map("mock_payments")
}

enum MockPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// A file attached to a tool's record. Kept as a record: a database trigger
/// rejects UPDATE and DELETE.
model Attachment {
  id           String   @id @default(cuid())
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  filename     String
  /// Detected from the file's contents, not the browser's claim.
  contentType  String   @map("content_type")
  sizeBytes    Int      @map("size_bytes")
  sha256       String
  storageKey   String   @unique @map("storage_key")
  uploadedById String   @map("uploaded_by_id")
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@map("attachments")
}
