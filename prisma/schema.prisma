generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPPORT
  FINANCE_APPROVER
  COMPLIANCE_REVIEWER
  COMPLIANCE_LEAD
  ADMIN
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

enum ApprovalStatus {
  PENDING
  PROCESSING
  OUTCOME_UNKNOWN
  COMPLETED
  REJECTED
}

model User {
  id           String     @id
  email        String     @unique
  name         String
  role         Role
  createdAt    DateTime   @default(now()) @map("created_at")
  auditEntries AuditLog[]
  requested    ApprovalRequest[] @relation("requestedBy")
  decided      ApprovalRequest[] @relation("decidedBy")

  @@map("users")
}

/// Append-only: a database trigger rejects UPDATE and DELETE.
model AuditLog {
  id         String       @id @default(cuid())
  createdAt  DateTime     @default(now()) @map("created_at")
  actorId    String?      @map("actor_id")
  actor      User?        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  /// Role at the time of the event; the user's role may change later.
  actorRole  Role?        @map("actor_role")
  action     String
  outcome    AuditOutcome
  entityType String?      @map("entity_type")
  entityId   String?      @map("entity_id")
  before     Json?
  after      Json?
  reason     String?

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([outcome, createdAt])
  @@index([entityType, entityId])
  @@map("audit_log")
}

model ApprovalRequest {
  id                  String         @id @default(cuid())
  /// Registered approval type key, e.g. `refunds.issue`.
  type                String
  status              ApprovalStatus @default(PENDING)
  payload             Json
  summary             String
  entityType          String?        @map("entity_type")
  entityId            String?        @map("entity_id")
  requestedById       String         @map("requested_by_id")
  requestedBy         User           @relation("requestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  requestReason       String         @map("request_reason")
  decidedById         String?        @map("decided_by_id")
  decidedBy           User?          @relation("decidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  decisionReason      String?        @map("decision_reason")
  decidedAt           DateTime?      @map("decided_at")
  processingStartedAt DateTime?      @map("processing_started_at")
  completedAt         DateTime?      @map("completed_at")
  lastError           String?        @map("last_error")
  attempts            Int            @default(0)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  @@index([status, type])
  @@index([requestedById, createdAt])
  @@index([status, processingStartedAt])
  @@map("approval_requests")
}

/// Backing store for the mock payments integration.
model MockPayment {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique @map("idempotency_key")
  kind           String
  paymentId      String   @map("payment_id")
  amountMinor    Int      @map("amount_minor")
  currency       String
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("mock_payments")
}
