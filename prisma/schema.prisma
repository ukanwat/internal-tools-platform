generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPPORT
  FINANCE_APPROVER
  COMPLIANCE_REVIEWER
  COMPLIANCE_LEAD
  ENGINEER
  ENG_MANAGER
  ADMIN
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

enum ApprovalStatus {
  PENDING
  PROCESSING
  OUTCOME_UNKNOWN
  COMPLETED
  REJECTED
}

model User {
  id           String             @id
  email        String             @unique
  name         String
  role         Role
  createdAt    DateTime           @default(now()) @map("created_at")
  auditEntries AuditLog[]
  requested    ApprovalRequest[]  @relation("requestedBy")
  decided      ApprovalRequest[]  @relation("decidedBy")
  flagChanges  FeatureFlagState[]
  attachments  Attachment[]

  @@map("users")
}

/// Append-only: a database trigger rejects UPDATE and DELETE.
model AuditLog {
  id         String       @id @default(cuid())
  createdAt  DateTime     @default(now()) @map("created_at")
  actorId    String?      @map("actor_id")
  actor      User?        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  /// Role at the time of the event; the user's role may change later.
  actorRole  Role?        @map("actor_role")
  action     String
  outcome    AuditOutcome
  entityType String?      @map("entity_type")
  entityId   String?      @map("entity_id")
  before     Json?
  after      Json?
  reason     String?

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([outcome, createdAt])
  @@index([entityType, entityId])
  @@map("audit_log")
}

model ApprovalRequest {
  id                  String         @id @default(cuid())
  /// Registered approval type key, e.g. `refunds.issue`.
  type                String
  status              ApprovalStatus @default(PENDING)
  payload             Json
  summary             String
  entityType          String?        @map("entity_type")
  entityId            String?        @map("entity_id")
  requestedById       String         @map("requested_by_id")
  requestedBy         User           @relation("requestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  requestReason       String         @map("request_reason")
  decidedById         String?        @map("decided_by_id")
  decidedBy           User?          @relation("decidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  decisionReason      String?        @map("decision_reason")
  decidedAt           DateTime?      @map("decided_at")
  processingStartedAt DateTime?      @map("processing_started_at")
  completedAt         DateTime?      @map("completed_at")
  lastError           String?        @map("last_error")
  attempts            Int            @default(0)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  @@index([status, type])
  @@index([requestedById, createdAt])
  @@index([status, processingStartedAt])
  @@map("approval_requests")
}

/// Backing store for the mock payments integration.
model MockPayment {
  id             String            @id @default(cuid())
  idempotencyKey String            @unique @map("idempotency_key")
  kind           String
  paymentId      String            @map("payment_id")
  amountMinor    Int               @map("amount_minor")
  currency       String
  status         MockPaymentStatus @default(PENDING)
  createdAt      DateTime          @default(now()) @map("created_at")

  @@map("mock_payments")
}

enum MockPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum FlagEnvironment {
  STAGING
  PRODUCTION
}

model FeatureFlag {
  id          String             @id @default(cuid())
  /// Stable key the application code reads, e.g. `checkout-v2`.
  key         String             @unique
  description String
  createdAt   DateTime           @default(now()) @map("created_at")
  states      FeatureFlagState[]

  @@map("feature_flags")
}

/// A flag's setting in one environment.
model FeatureFlagState {
  id             String                @id @default(cuid())
  flagId         String                @map("flag_id")
  flag           FeatureFlag           @relation(fields: [flagId], references: [id], onDelete: Restrict)
  environment    FlagEnvironment
  enabled        Boolean               @default(false)
  /// Share of traffic that sees the flag while it's on, 0–100.
  rolloutPercent Int                   @default(0) @map("rollout_percent")
  /// Bumped on every change so stale edits and approvals can't overwrite newer ones.
  version        Int                   @default(0)
  updatedById    String?               @map("updated_by_id")
  updatedBy      User?                 @relation(fields: [updatedById], references: [id], onDelete: Restrict)
  updatedAt      DateTime              @updatedAt @map("updated_at")
  appliedChanges FeatureFlagApproval[]

  @@unique([flagId, environment])
  @@map("feature_flag_states")
}

/// One row per approval request that has been applied, so a retried execution is a no-op.
model FeatureFlagApproval {
  approvalRequestId String           @id @map("approval_request_id")
  stateId           String           @map("state_id")
  state             FeatureFlagState @relation(fields: [stateId], references: [id], onDelete: Restrict)
  appliedAt         DateTime         @default(now()) @map("applied_at")

  @@map("feature_flag_approvals")
}

/// A file attached to a tool's record. Kept as a record: a database trigger
/// rejects UPDATE and DELETE.
model Attachment {
  id           String   @id @default(cuid())
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  filename     String
  /// Detected from the file's contents, not the browser's claim.
  contentType  String   @map("content_type")
  sizeBytes    Int      @map("size_bytes")
  sha256       String
  storageKey   String   @unique @map("storage_key")
  uploadedById String   @map("uploaded_by_id")
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@map("attachments")
}
