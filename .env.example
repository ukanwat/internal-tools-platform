# Copy to .env and adjust as needed: cp .env.example .env
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/internal_tools?schema=public"

# Signs the session cookie. Dev-only value; generate a real one with: openssl rand -base64 32
SESSION_SECRET="dev-only-session-secret-change-me-0123456789"

# How long an approved request may stay processing before it is treated as failed (default 5 minutes).
APPROVAL_PROCESSING_TIMEOUT_MS=300000

# Refunds above this many US dollars need finance approval; smaller ones are paid straight away (default 500).
REFUND_APPROVAL_THRESHOLD_USD=500
